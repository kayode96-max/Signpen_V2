# Signpen environment.
# Copy to .env.local for local development. In Vercel, set the same names
# separately for Preview and for Production. Use different values in each,
# especially SUPABASE_SERVICE_ROLE_KEY. TURNSTILE_SECRET_KEY and
# GOOGLE_API_KEY are optional; use different values per environment if you
# set them. Never commit real values.
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser.
# Never put SUPABASE_SERVICE_ROLE_KEY, TURNSTILE_SECRET_KEY or GOOGLE_API_KEY
# behind a NEXT_PUBLIC_ name. The server does not read
# NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
#
# Visitor IPs are hashed inside Postgres (private.hash_ip, salt in
# private.app_config, created by the security hotfix migration). There is no
# IP salt environment variable.

# --- Browser (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Cloudflare Turnstile site key. Public by design.
# Captcha turns on only when this AND TURNSTILE_SECRET_KEY are both non-empty.
# Leave empty for the no-captcha launch. The widget and its script are omitted.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only ---
# Supabase service role. Bypasses RLS. Use each environment's own project key:
# the preview project's key for Preview, the production project's key for Production.
# Used by /api/signatures (+ /challenge, /[id]), /api/feedback,
# /api/sentiment-summary and /api/account. Without it those routes return 503.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Same switch as NEXT_PUBLIC_TURNSTILE_SITE_KEY. One key alone
# leaves captcha off. Never log this value.
# When both keys are set, /api/feedback sends this to siteverify, and
# /api/signatures sends it only after the hashed IP is over the hourly board cap.
# When either key is missing, those routes skip verification. The hashed-IP
# limits still apply. Over the signature cap the response is 429
# {"error":"rate_limited"} with Retry-After, not challenge_required.
TURNSTILE_SECRET_KEY=

# Optional. /api/sentiment-summary only. If unset, that route returns 503
# {"error":"summary_unavailable"} and does not throw. Signing, the board, and
# the rest of the dashboard do not read it. The production build does not
# require it.
GOOGLE_API_KEY=
# Optional model id. Used only when GOOGLE_API_KEY is set. Default gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Present in older docs. The Next.js routes in this repo do not read these.
RUST_BACKEND_URL=
SUPABASE_PROJECT_ID=
SUPABASE_ANON_KEY=
