# Signpen environment.
# Copy to .env.local for local development. In Vercel, set the same names
# separately for Preview and for Production. Use different values in each,
# especially SUPABASE_SERVICE_ROLE_KEY, IP_HASH_SALT, TURNSTILE_SECRET_KEY,
# and GOOGLE_API_KEY. Never commit real values.
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser.
# Never put SUPABASE_SERVICE_ROLE_KEY, IP_HASH_SALT, TURNSTILE_SECRET_KEY,
# or GOOGLE_API_KEY behind a NEXT_PUBLIC_ name. The server does not read
# NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.

# --- Browser (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key. Public by design. Pair with TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only ---
# Supabase service role. Bypasses RLS. Used by /api/signatures, /api/feedback,
# /api/sentiment-summary, and /api/account.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC salt for visitor IP addresses. Raw IPs are never written to the database.
# Generate with: openssl rand -hex 32
# Use a different salt in Preview and Production. Rotating it resets rate-limit history.
IP_HASH_SALT=

# Cloudflare Turnstile secret. /api/feedback sends this to siteverify. Server only.
TURNSTILE_SECRET_KEY=

# Gemini. /api/sentiment-summary only. Server only.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Present in older docs. The Next.js routes in this repo do not read these.
RUST_BACKEND_URL=
SUPABASE_PROJECT_ID=
SUPABASE_ANON_KEY=
