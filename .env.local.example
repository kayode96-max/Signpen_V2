# Frontend Configuration (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (never NEXT_PUBLIC_). Required by POST /api/signatures to call record_signed_ip.
# Use each environment's own project key: preview key for Preview, production key for Production.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Rust backend base URL for API proxying.
# When empty, Next.js falls back to local routing or errors out.
RUST_BACKEND_URL=http://127.0.0.1:8080

# Backend Configuration (Rust Backend)
# Required by the Rust backend service (set in shell or backend-rust/.env)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_PROJECT_ID=
SUPABASE_ANON_KEY=
